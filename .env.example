# Local demo credentials only. Change before exposing this environment.
MYSQL_ROOT_PASSWORD=local-root-change-me
MYSQL_PASSWORD=local-app-change-me
MYSQL_PORT=13306
BACKEND_PORT=8080
FRONTEND_PORT=3000
# If changing the frontend port/hostname, include that exact browser origin here.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Concurrent background tasks per Java instance (1..32)
TASK_WORKER_CONCURRENCY=4

# Total attempts including first execution and recovery claims (1..6)
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BASE_DELAY_MS=1000
TASK_RETRY_MAX_DELAY_MS=30000
TASK_LEASE_MS=120000
TASK_HEARTBEAT_INTERVAL_MS=1000
